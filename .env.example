## PostgreSQL connection string (Prisma)
## Example:
## DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pizza_app?schema=public"
DATABASE_URL=

## Security
## Generate independent random values of at least 32 bytes for both secrets.
NODE_ENV=production
API_HOST=127.0.0.1
PORT=3000
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_ISSUER=pizza-app-backend
JWT_AUDIENCE=app-factura
PIN_PEPPER=
TRUST_PROXY_HOPS=0

## One-time bootstrap credentials used by `npm run db:setup`.
## The seed rotates an existing bootstrap administrator and never logs secrets.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PIN=

## Comma-separated list of exact allowed origins.
## A localhost installation automatically accepts the packaged Electron app and
## the Vite development server. Configure this when API_HOST is not localhost.
## Example: CORS_ORIGINS="https://pos.example.com"
CORS_ORIGINS=

## Swagger is disabled by default in every environment.
SWAGGER_ENABLED=false

## Configuración de Servidor de Correos (SMTP)
## Para Gmail: host=smtp.gmail.com, port=587, user=tu_correo, pass=contraseña_de_aplicación
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
